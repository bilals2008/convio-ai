generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id        String    @id
  email     String
  name      String?
  avatar    String?
  createdAt DateTime  @default(now()) @db.Timestamptz()
  updatedAt DateTime  @updatedAt @db.Timestamptz()

  memberships Membership[]
  createdBots Bot[]       @relation("BotCreator")

  @@map("profiles")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logo      String?
  plan      String   @default("free")
  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  memberships    Membership[]
  agents         Agent[]
  bots           Bot[]
  knowledgeBases KnowledgeBase[]
  tools          Tool[]
  providerKeys   ProviderKey[]
  apiKeys        ApiKey[]

  @@index([slug])
}

model ApiKey {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  key            String    @unique
  keyPreview     String
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now()) @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([key])
}

model Membership {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  role           String   @default("member")
  createdAt      DateTime @default(now()) @db.Timestamptz()

  profile      Profile      @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model Agent {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  model          String   @default("gpt-4o-mini")
  systemPrompt   String
  temperature    Float    @default(0.7)
  maxTokens      Int?
  providerKeyId  String?
  createdAt      DateTime @default(now()) @db.Timestamptz()
  updatedAt      DateTime @updatedAt @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id])
  providerKey  ProviderKey? @relation(fields: [providerKeyId], references: [id])
  bots         Bot[]
  tools        AgentTool[]

  @@index([organizationId])
}

model ProviderKey {
  id             String   @id @default(uuid())
  organizationId String
  provider       String
  apiKey         String
  keyPreview     String
  label          String?
  createdAt      DateTime @default(now()) @db.Timestamptz()
  updatedAt      DateTime @updatedAt @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id])
  agents       Agent[]

  @@unique([organizationId, provider])
  @@index([organizationId])
}

model Bot {
  id             String   @id @default(uuid())
  organizationId String
  agentId        String
  createdById    String?
  name           String
  description    String?
  avatar         String?
  widgetColor    String   @default("#fb923c")
  welcomeMessage String?
  widgetConfig   Json?
  status         String   @default("draft")
  createdAt      DateTime @default(now()) @db.Timestamptz()
  updatedAt      DateTime @updatedAt @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id])
  agent        Agent         @relation(fields: [agentId], references: [id])
  creator      Profile?      @relation("BotCreator", fields: [createdById], references: [id])
  conversations Conversation[]
  integrations  Integration[]
  analytics     Analytics[]

  @@index([organizationId])
  @@index([agentId])
  @@index([createdById])
  @@index([status, createdAt])
}

model Conversation {
  id         String   @id @default(uuid())
  botId      String
  userId     String?
  channel    String   @default("web")
  status     String   @default("active")
  createdAt  DateTime @default(now()) @db.Timestamptz()
  updatedAt  DateTime @updatedAt @db.Timestamptz()

  bot      Bot       @relation(fields: [botId], references: [id])
  messages Message[]

  @@index([botId, createdAt])
  @@index([userId])
  @@index([status])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  role           String
  content        String
  status         String   @default("sent")
  metadata       Json?
  createdAt      DateTime @default(now()) @db.Timestamptz()

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, createdAt])
}

model KnowledgeBase {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now()) @db.Timestamptz()
  updatedAt      DateTime @updatedAt @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id])
  documents    Document[]

  @@index([organizationId])
}

model Document {
  id              String   @id @default(uuid())
  knowledgeBaseId String
  name            String
  type            String
  content         String?
  url             String?
  status          String   @default("pending")
  createdAt       DateTime @default(now()) @db.Timestamptz()

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id])

  @@index([knowledgeBaseId])
  @@index([status])
}

model Tool {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String
  type           String
  config         Json     @default("{}")
  createdAt      DateTime @default(now()) @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id])
  agents       AgentTool[]

  @@index([organizationId])
}

model AgentTool {
  agentId String
  toolId  String

  agent Agent @relation(fields: [agentId], references: [id])
  tool  Tool  @relation(fields: [toolId], references: [id])

  @@id([agentId, toolId])
  @@index([toolId])
}

model Integration {
  id        String   @id @default(uuid())
  botId     String
  channel   String
  config    Json     @default("{}")
  status    String   @default("active")
  createdAt DateTime @default(now()) @db.Timestamptz()

  bot Bot @relation(fields: [botId], references: [id])

  @@index([botId])
  @@index([channel, status])
}

model Analytics {
  id                 String   @id @default(uuid())
  botId              String
  date               DateTime @db.Date()
  totalConversations Int      @default(0)
  totalMessages      Int      @default(0)
  uniqueUsers        Int      @default(0)
  avgResponseTime    Float    @default(0)
  satisfactionScore  Float?
  createdAt          DateTime @default(now()) @db.Timestamptz()

  bot Bot @relation(fields: [botId], references: [id])

  @@unique([botId, date])
  @@index([botId])
}
