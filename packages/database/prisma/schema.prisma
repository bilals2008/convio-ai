generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id            String       @id
  email         String
  name          String?
  avatar        String?
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(6)
  createdAgents Agent[]      @relation("AgentCreator")
  memberships   Membership[]
  invitedMe     Invitation[]

  @@index([email])
  @@map("profiles")
}

model Organization {
  id               String            @id @default(uuid())
  name             String
  slug             String            @unique
  logo             String?
  plan             String            @default("free")
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(6)
  agents           Agent[]
  knowledgeBases   KnowledgeBase[]
  memberships      Membership[]
  providerKeys     ProviderKey[]
  tools            Tool[]
  widgets          Widget[]
  auditLogs        AuditLog[]
  invitations      Invitation[]
  moderationConfig ModerationConfig?
  ssoConfigs       SsoConfig?
  billingCustomer  BillingCustomer?


  @@index([slug])
}

model Membership {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           String       @default("member")
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id])
  profile        Profile      @relation(fields: [userId], references: [id])

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model Agent {
  id              String         @id @default(uuid())
  organizationId  String
  name            String
  description     String?
  model           String         @default("gpt-4o-mini")
  systemPrompt    String
  temperature     Float          @default(0.7)
  maxTokens       Int?
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(6)
  providerKeyId   String?
  knowledgeBaseId String?
  avatar          String?
  createdById     String?
  status          String         @default("draft")
  welcomeMessage  String?
  widgetColor     String         @default("#fb923c")
  widgetConfig    Json?
  creator         Profile?       @relation("AgentCreator", fields: [createdById], references: [id])
  knowledgeBase   KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id])
  organization    Organization   @relation(fields: [organizationId], references: [id])
  providerKey     ProviderKey?   @relation(fields: [providerKeyId], references: [id])
  tools           AgentTool[]
  analytics       Analytics[]
  conversations   Conversation[]
  deployments     Deployment[]
  widgets         Widget[]

  @@index([organizationId])
  @@index([knowledgeBaseId])
  @@index([status, createdAt])
  @@index([organizationId, createdAt])
}

model ProviderKey {
  id             String       @id @default(uuid())
  organizationId String
  provider       String
  apiKey         String
  keyPreview     String
  label          String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  agents         Agent[]
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, provider])
  @@index([organizationId])
}

model Deployment {
  id        String   @id @default(uuid())
  agentId   String
  channel   String
  config    Json     @default("{}")
  status    String   @default("active")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([channel, status])
}

model Widget {
  id             String       @id @default(uuid())
  publicKey      String       @unique @default(cuid())
  organizationId String
  agentId        String
  name           String
  status         String       @default("draft")
  config         Json         @default("{}")
  allowedDomains String[]     @default([])
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  agent          Agent        @relation(fields: [agentId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, updatedAt(sort: Desc)])
  @@index([agentId])
  @@index([status])
}

model Conversation {
  id           String    @id @default(uuid())
  userId       String?
  channel      String    @default("web")
  status       String    @default("active")
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)
  agentId      String
  contactName  String?
  contactPhone String?
  metadata     Json?
  agent        Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([agentId, createdAt])
  @@index([agentId, updatedAt(sort: Desc)])
  @@index([agentId, status, updatedAt(sort: Desc)])
  @@index([userId])
  @@index([status])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String
  content        String
  status         String       @default("sent")
  metadata       Json?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([createdAt])
}

model KnowledgeBase {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  agents         Agent[]
  documents      Document[]
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model Document {
  id              String          @id @default(uuid())
  knowledgeBaseId String
  name            String
  type            String
  content         String?
  url             String?
  status          String          @default("pending")
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  fileKey         String?
  knowledgeBase   KnowledgeBase   @relation(fields: [knowledgeBaseId], references: [id])
  chunks          DocumentChunk[]

  @@index([knowledgeBaseId])
  @@index([status])
  @@index([knowledgeBaseId, status, createdAt(sort: Desc)])
}

model DocumentChunk {
  id         String                 @id @default(uuid())
  documentId String
  content    String
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime               @default(now()) @db.Timestamptz(6)
  document   Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model Tool {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String
  type           String
  config         Json         @default("{}")
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  agents         AgentTool[]
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model AgentTool {
  agentId String
  toolId  String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tool    Tool   @relation(fields: [toolId], references: [id])

  @@id([agentId, toolId])
  @@index([toolId])
}

model Analytics {
  id                 String   @id @default(uuid())
  date               DateTime @db.Date
  totalConversations Int      @default(0)
  totalMessages      Int      @default(0)
  uniqueUsers        Int      @default(0)
  avgResponseTime    Float    @default(0)
  satisfactionScore  Float?
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  agentId            String
  agent              Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, date])
  @@index([agentId])
}

model Invitation {
  id             String       @id @default(uuid())
  email          String
  organizationId String
  role           String       @default("member")
  token          String       @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id])
  invitedBy      Profile?     @relation(fields: [invitedById], references: [id])

  @@index([email])
  @@index([token])
  @@index([organizationId])
  @@map("invitations")
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, action])
  @@index([organizationId, entityType])
  @@index([actorId])
  @@map("audit_logs")
}

model ModerationConfig {
  id               String       @id @default(uuid())
  organizationId   String       @unique
  enabled          Boolean      @default(false)
  profanityEnabled Boolean      @default(true)
  piiEnabled       Boolean      @default(true)
  injectionEnabled Boolean      @default(true)
  blockOnViolation Boolean      @default(true)
  customRules      Json         @default("[]")
  createdAt        DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(6)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("moderation_configs")
}

model SsoConfig {
  id             String       @id @default(uuid())
  organizationId String       @unique
  provider       String       @default("saml")
  issuer         String?
  entryPoint     String?
  certificate    String?
  metadataUrl    String?
  enabled        Boolean      @default(false)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("sso_configs")
}

model BillingCustomer {
  id                  String          @id @default(uuid())
  organizationId      String          @unique
  providerCustomerId  String          @unique
  createdAt           DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(6)

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptions  Subscription[]
  invoices       Invoice[]

  @@map("billing_customers")
}

model Subscription {
  id                      String          @id @default(uuid())
  customerId              String
  providerSubscriptionId  String          @unique
  providerProductId       String
  providerPlanId          String
  plan                    String
  status                  String
  trialEndsAt             DateTime?       @db.Timestamptz(6)
  renewsAt                DateTime?       @db.Timestamptz(6)
  endsAt                  DateTime?       @db.Timestamptz(6)
  cancelAtPeriodEnd       Boolean         @default(false)
  createdAt               DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime        @updatedAt @db.Timestamptz(6)

  customer  BillingCustomer @relation(fields: [customerId], references: [id])
  invoices  Invoice[]

  @@index([customerId])
  @@index([status])
  @@map("subscriptions")
}

model Invoice {
  id                String          @id @default(uuid())
  subscriptionId    String?
  customerId        String
  providerInvoiceId String          @unique
  invoiceNumber     String?
  status            String
  total             Float
  currency          String          @default("USD")
  invoiceUrl        String?
  paidAt            DateTime?       @db.Timestamptz(6)
  billingReason     String?
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)

  subscription  Subscription?   @relation(fields: [subscriptionId], references: [id])
  customer      BillingCustomer  @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([subscriptionId])
  @@index([createdAt(sort: Desc)])
  @@map("invoices")
}







