generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id        String    @id
  email     String
  name      String?
  avatar    String?
  createdAt DateTime  @default(now()) @db.Timestamptz()
  updatedAt DateTime  @updatedAt @db.Timestamptz()

  memberships   Membership[]
  createdAgents Agent[]       @relation("AgentCreator")

  @@map("profiles")
  @@index([email])
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logo      String?
  plan      String   @default("free")
  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  memberships    Membership[]
  agents         Agent[]
  knowledgeBases KnowledgeBase[]
  tools          Tool[]
  providerKeys   ProviderKey[]
  apiKeys        ApiKey[]
  auditLogs      AuditLog[]
  ssoConfigs     SsoConfig[]
  widgets        Widget[]

  @@index([slug])
}

model ApiKey {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  key            String    @unique
  keyPreview     String
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now()) @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([key])
}

model Membership {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  role           String   @default("member")
  createdAt      DateTime @default(now()) @db.Timestamptz()

  profile      Profile      @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model Agent {
  id              String        @id @default(uuid())
  organizationId  String
  createdById     String?
  name            String
  description     String?
  model           String        @default("gpt-4o-mini")
  systemPrompt    String
  temperature     Float         @default(0.7)
  maxTokens       Int?
  providerKeyId   String?
  knowledgeBaseId String?
  avatar          String?
  widgetColor     String        @default("#fb923c")
  welcomeMessage  String?
  widgetConfig    Json?
  status          String        @default("draft")
  createdAt       DateTime      @default(now()) @db.Timestamptz()
  updatedAt       DateTime      @updatedAt @db.Timestamptz()

  organization  Organization  @relation(fields: [organizationId], references: [id])
  creator       Profile?      @relation("AgentCreator", fields: [createdById], references: [id])
  providerKey   ProviderKey?  @relation(fields: [providerKeyId], references: [id])
  knowledgeBase KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id])
  tools         AgentTool[]
  deployments   Deployment[]
  conversations Conversation[]
  analytics     Analytics[]
  widgets       Widget[]

  @@index([organizationId])
  @@index([knowledgeBaseId])
  @@index([status, createdAt])
  @@index([organizationId, createdAt])
}

model ProviderKey {
  id             String   @id @default(uuid())
  organizationId String
  provider       String
  apiKey         String
  keyPreview     String
  label          String?
  createdAt      DateTime @default(now()) @db.Timestamptz()
  updatedAt      DateTime @updatedAt @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id])
  agents       Agent[]

  @@unique([organizationId, provider])
  @@index([organizationId])
}

model Deployment {
  id        String   @id @default(uuid())
  agentId   String
  channel   String
  config    Json     @default("{}")
  status    String   @default("active")
  createdAt DateTime @default(now()) @db.Timestamptz()

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([channel, status])
}

model Widget {
  id             String   @id @default(uuid())
  publicKey      String   @unique @default(cuid())
  organizationId String
  agentId        String
  name           String
  status         String   @default("draft")
  config         Json     @default("{}")
  allowedDomains String[] @default([])
  createdAt      DateTime @default(now()) @db.Timestamptz()
  updatedAt      DateTime @updatedAt @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Restrict)

  @@index([organizationId, updatedAt(sort: Desc)])
  @@index([agentId])
  @@index([status])
}

model Conversation {
  id          String   @id @default(uuid())
  agentId     String
  userId      String?
  channel     String   @default("web")
  status      String   @default("active")
  contactName String?
  contactPhone String?
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz()
  updatedAt   DateTime @updatedAt @db.Timestamptz()

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  messages Message[]

  @@index([agentId, createdAt])
  @@index([agentId, updatedAt(sort: Desc)])
  @@index([agentId, status, updatedAt(sort: Desc)])
  @@index([userId])
  @@index([status])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  role           String
  content        String
  status         String   @default("sent")
  metadata       Json?
  createdAt      DateTime @default(now()) @db.Timestamptz()

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([createdAt])
}

model KnowledgeBase {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now()) @db.Timestamptz()
  updatedAt      DateTime @updatedAt @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id])
  documents    Document[]
  agents       Agent[]

  @@index([organizationId])
}

model Document {
  id              String           @id @default(uuid())
  knowledgeBaseId String
  name            String
  type            String
  content         String?
  url             String?
  fileKey         String?
  status          String           @default("pending")
  createdAt       DateTime         @default(now()) @db.Timestamptz()

  knowledgeBase KnowledgeBase  @relation(fields: [knowledgeBaseId], references: [id])
  chunks        DocumentChunk[]

  @@index([knowledgeBaseId])
  @@index([status])
  @@index([knowledgeBaseId, status, createdAt(sort: Desc)])
}

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String
  content    String
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime @default(now()) @db.Timestamptz()

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model Tool {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String
  type           String
  config         Json     @default("{}")
  createdAt      DateTime @default(now()) @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id])
  agents       AgentTool[]

  @@index([organizationId])
}

model AgentTool {
  agentId String
  toolId  String

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tool  Tool  @relation(fields: [toolId], references: [id])

  @@id([agentId, toolId])
  @@index([toolId])
}

model Analytics {
  id                 String   @id @default(uuid())
  agentId            String
  date               DateTime @db.Date()
  totalConversations Int      @default(0)
  totalMessages      Int      @default(0)
  uniqueUsers        Int      @default(0)
  avgResponseTime    Float    @default(0)
  satisfactionScore  Float?
  createdAt          DateTime @default(now()) @db.Timestamptz()

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, date])
  @@index([agentId])
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now()) @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, action])
  @@index([organizationId, entityType])
  @@index([actorId])
  @@map("audit_logs")
}

model SsoConfig {
  id              String   @id @default(uuid())
  organizationId  String   @unique
  provider        String   @default("saml")
  issuer          String?
  entryPoint      String?
  certificate     String?
  metadataUrl     String?
  enabled         Boolean  @default(false)
  createdAt       DateTime @default(now()) @db.Timestamptz()
  updatedAt       DateTime @updatedAt @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("sso_configs")
}
