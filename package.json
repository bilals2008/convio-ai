    "dotenv": "^16.4.0",
    "eslint": "^10.6.0",
    "globals": "^17",
    "pg": "^8.13.0",
    "prettier": "^3.0.0",
    "prisma": "^7.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8"
  },
  "packageManager": "pnpm@11.17.0"
