# ============================================================
# Convio Backend - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# For Railway deployment, add these via the Railway Dashboard.
# Required variables are marked with [REQUIRED].
# All others are optional and will gracefully disable features when missing.
# ============================================================

# ---- Server ----
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
# API's externally reachable URL (webhooks, OAuth callbacks) - NOT the frontend
PUBLIC_URL=http://localhost:3000
# Frontend base URL - used for email invite links. In prod: https://your-app.vercel.app
WEB_URL=http://localhost:5173

# ---- Database [REQUIRED] ----
# Postgres connection string (Supabase, Railway Postgres, or any PG)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/convio
# Direct connection (bypasses pgBouncer for migrations)
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/convio

# ---- Encryption [REQUIRED in production] ----
# Used to encrypt provider API keys at rest (AES-256-GCM). If unset in
# production, provider keys fall back to plaintext storage - set this!
ENCRYPTION_KEY=

# ---- Supabase Auth [REQUIRED] ----
# Required for JWT verification and user management
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                          # Admin operations

# ---- AI Providers (bring-your-own-key) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENCODE_API_KEY=
TAVILY_API_KEY=                                    # Web search for agents
LOCAL_API_URL=http://localhost:20128/v1             # Local AI gateway

# ---- GitHub Models (for embeddings) ----
GITHUB_PAT=

# ---- WhatsApp (Kapso Platform) ----
KAPSO_ORG_API_KEY=
KAPSO_API_BASE_URL=https://api.kapso.ai/meta/whatsapp

# ---- Twilio WhatsApp (fallback/production) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=

# ---- Discord ----
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_GATEWAY_ENABLED=true                           # Set false on local to prevent duplicate responses when Railway is also running

# ---- Resend (Transactional emails) ----
RESEND_API_KEY=
RESEND_FROM=yourname@example.com
RESEND_AUDIENCE_ID=

# ---- Storage ----
STORAGE_BUCKET=convio

# ---- Creem (Billing / Payment) ----
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRO_MONTHLY_PRODUCT_ID=
CREEM_PRO_YEARLY_PRODUCT_ID=
CREEM_BUSINESS_MONTHLY_PRODUCT_ID=
CREEM_BUSINESS_YEARLY_PRODUCT_ID=
CREEM_ENTERPRISE_PRODUCT_ID=
CREEM_TEST_MODE=false

# ---- Scheduled broadcasts ----
# Guards POST /api/broadcasts/process (cron). Set in production.
CRON_SECRET=

# ---- Platform Admin (comma-separated emails for admin panel access) ----
PLATFORM_ADMIN_EMAILS=

# ---- Frontend URLs (for shareable links, CORS) ----
# VITE_* vars moved to apps/web/.env.example - set there for frontend.
# On Vercel, set in dashboard.
